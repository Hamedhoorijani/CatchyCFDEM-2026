# Pseudo-2D e-Bed, graphite granules - CFD-DEM run (Table S4)
# atom types: 1 conductive particle, 2 non-conductive particle,
#             3 conductive wall (electrode), 4 non-conductive wall
################################################################################# 

# general
variable cg        equal 2
variable firstRun  equal 1              # 1 = set bed temperature, 0 = continuing run

# restitution
variable ePP       equal 0.6
variable ePW       equal 0.6
variable eWW       equal 0.5

# friction
variable muPP      equal 0.2
variable muPW      equal 0.3
variable muWW      equal 0.3

# elastic
variable nu        equal 0.27
variable YP        equal 1.0e7          # [Pa]
variable YW        equal 1.0e7          # [Pa]
variable YoP       equal 1.0e10         # [Pa]
variable YoW       equal 1.0e10         # [Pa]
variable aSpot     equal 0.006          # contact-area correction factor

# thermal
variable kP        equal 168.0          # [W/m/K]
variable kW3       equal 168.0          # [W/m/K]
variable kW4       equal 1.38           # [W/m/K]
variable cpP       equal 1000.0         # [J/kg/K]
variable cpW3      equal 1000.0         # [J/kg/K]
variable cpW4      equal 749.0          # [J/kg/K]
variable emP       equal 0.7
variable emW3      equal 0.7
variable emW4      equal 0.93
variable T0        equal 298            # [K]
variable Trad      equal 298            # radiation sink temperature [K]
variable Tctrl     equal 1073           # [K]

# electrical
variable ECP       equal 5.0e4          # [S/m]
variable ECW       equal 5.0e6          # [S/m]
variable ECW2      equal 1.0e-10        # [S/m]
variable alphaP    equal 0.004          # [1/K]
variable alphaW3   equal 0.004          # [1/K]
variable alphaW4   equal 0.004          # [1/K]
variable Tref      equal 293.15         # [K]
variable sigFloor  equal 1.0e-6         # [S/m]
variable epsRelP   equal 12.5
variable epsRelG   equal 1.00054
variable Vapp      equal 60.0           # [V], 10-80
variable Vgnd      equal 0.0            # [V]

# numerics / coupling / output
variable skin      equal 0.001          # [m]
variable dt        equal 2.0e-6         # [s]
variable g         equal 9.81           # [m/s2]
variable coupleEv  equal 200            # CFD dt = coupleEv*dt = 4e-4 s
variable exportEv  equal 2000
variable nThermo   equal 200
variable nPrint    equal 100
variable nEvol     equal 50000
variable nDump     equal 50000


echo            both
log             ../DEM/log.liggghts
thermo_log      ../DEM/post/thermo.txt

atom_style      granular
atom_modify     map array
communicate     single vel yes
coarsegraining  ${cg}

boundary        m m m
newton          off

units           si
processors      * * *

read_restart    ../DEM/post/restart/liggghts.restart

neighbor        ${skin} bin
neigh_modify    delay 0

fix         m1 all property/global youngsModulus peratomtype ${YP} ${YP} ${YW} ${YW}
fix         m2 all property/global poissonsRatio peratomtype ${nu} ${nu} ${nu} ${nu}
fix         m3 all property/global coefficientRestitution peratomtypepair 4 &
            ${ePP} ${ePP} ${ePW} ${ePW} &
            ${ePP} ${ePP} ${ePW} ${ePW} &
            ${ePW} ${ePW} ${eWW} ${eWW} &
            ${ePW} ${ePW} ${eWW} ${eWW}
fix         m4 all property/global coefficientFriction peratomtypepair 4 &
            ${muPP} ${muPP} ${muPW} ${muPW} &
            ${muPP} ${muPP} ${muPW} ${muPW} &
            ${muPW} ${muPW} ${muWW} ${muWW} &
            ${muPW} ${muPW} ${muWW} ${muWW}
fix         m5 all property/global youngsModulusOriginal peratomtype ${YoP} ${YoP} ${YoW} ${YoW}
fix         m6 all property/global electricalConductivity peratomtype ${ECP} ${ECP} ${ECW} ${ECW2}
fix         m7 all property/global epsilonP scalar ${epsRelP}
fix         m8 all property/global epsilonG scalar ${epsRelG}
fix         m9 all property/global thermalEmissivity peratomtype ${emP} ${emP} ${emW3} ${emW4}
fix         m11 all property/global electricalAspotFraction peratomtype ${aSpot} ${aSpot} ${aSpot} ${aSpot}

# sigma(T) = sigma0 / (1 + alpha*(T - Tref))
fix         m12 all property/global electricalSigma0     peratomtype ${ECP} ${ECP} ${ECW} ${ECW2}
fix         m13 all property/global electricalAlpha      peratomtype ${alphaP} ${alphaP} ${alphaW3} ${alphaW4}
fix         m14 all property/global electricalTref       scalar ${Tref}
fix         m15 all property/global electricalSigmaFloor scalar ${sigFloor}

fix         eP      all property/atom eP      scalar yes yes yes 0.0
fix         qj      all property/atom qj      scalar yes yes yes 0.0
fix         qj_pp   all property/atom qj_pp   scalar yes yes yes 0.0
fix         qj_pw   all property/atom qj_pw   scalar yes yes yes 0.0
fix         cMatrix all property/atom cMatrix scalar yes yes yes 0.0
fix         pwEP    all property/atom pwEP    scalar yes yes yes 0.0
fix         pwER    all property/atom pwER    scalar yes yes yes 0.0
fix         eflag   all property/atom eflag   scalar yes yes yes 0.0
fix         tot_I   all property/atom tot_I   scalar yes yes yes 0.0
fix         total_C all property/atom total_C scalar yes yes yes 0.0

fix         pV all property/atom pV scalar yes yes no 0.0
fix         pE all property/atom pE vector yes yes no 0.0 0.0 0.0

pair_style  gran model hertz tangential history cohesion electric
pair_coeff  * *

timestep    ${dt}
fix         gravi all gravity ${g} vector 0.0 0.0 -1.0

fix     cad0 all mesh/surface file ../DEM/meshes/reactor2D.stl       type 4 scale 1 temperature ${T0}
fix     cad1 all mesh/surface file ../DEM/meshes/centerElectrode.stl type 3 scale 1 temperature ${T0} electricPotential ${Vapp}
fix     cad2 all mesh/surface file ../DEM/meshes/sideElectrodes.stl  type 3 scale 1 temperature ${T0} electricPotential ${Vgnd}

fix     geometry all wall/gran model hertz tangential history mesh n_meshes 3 meshes cad0 cad1 cad2

fix     cfd  all couple/cfd couple_every ${coupleEv} mpi
fix     cfd2 all couple/cfd/force/implicit
fix     cfd3 all couple/cfd/convection T0 ${T0}

fix     ftco all property/global thermalConductivity peratomtype ${kP}  ${kP}  ${kW3}  ${kW4}
fix     ftca all property/global thermalCapacity     peratomtype ${cpP} ${cpP} ${cpW3} ${cpW4}
fix     electrictransfer all heat/gran/electric7 initial_temperature ${T0} initial_electricPotential 0. start_time 0. &
        temp_control yes ${Tctrl} export_every ${exportEv} radiation yes ${Trad}

run     0
region  total block INF INF INF INF INF INF units box
if "${firstRun} == 1" then "set region total property/atom Temp ${T0}"

fix     integr all nve/sphere

compute     centerOfMass all com
compute     explDrag all reduce update_on_run_end yes sum f_dragforce[1] f_dragforce[2] f_dragforce[3]

variable    totalDragX equal f_cfd2[1]
variable    totalDragY equal f_cfd2[2]
variable    totalDragZ equal f_cfd2[3]

variable    explicitDragX equal c_explDrag[1]
variable    explicitDragY equal c_explDrag[2]
variable    explicitDragZ equal c_explDrag[3]

variable    time equal step*dt
fix         extra all print ${nPrint} "${time} ${explicitDragX} ${explicitDragY} ${explicitDragZ} ${totalDragX} ${totalDragY} ${totalDragZ}" file ../DEM/post/forces.txt title "# time expDrag(X Y Z) totDrag(X Y Z)"

compute         rke  all erotate/sphere
compute         tem  all reduce ave f_Temp[0]
compute         tem1 all reduce ave f_qj[0]
compute         tem2 all reduce ave f_eP[0]

thermo_style    custom step atoms ke c_rke vol c_centerOfMass[3] c_explDrag[1] c_explDrag[2] c_explDrag[3] c_tem c_tem1 c_tem2
thermo          ${nThermo}
thermo_modify   lost ignore norm no
compute_modify  thermo_temp dynamic yes

fix         ave_temp all print ${nEvol} "$(time), $(c_tem), $(c_tem1), $(c_tem2)" file ../DEM/post/evolutionDEM.csv

dump        dmpvtk all custom/vtk ${nDump} ../DEM/post/dump_liggghts_run.*.vtk id type x y z vx vy vz fx fy fz &
            f_dragforce[1] f_dragforce[2] f_dragforce[3] radius f_Temp[0] f_cMatrix[0] f_eP[0] f_qj[0] f_qr[0] &
            f_pwEP[0] f_pwER[0] f_heatFlux[0] f_heatSource[0] f_current[1] f_current[2] f_current[3] &
            f_compID[0] f_tot_I[0] f_total_C[0] f_qj_pw[0] f_qj_pp[0]

reset_timestep  0
run             0
