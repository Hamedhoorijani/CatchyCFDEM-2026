################################################################################
#  Fixed bed (steel spheres, Lu et al. 2022 set-up) - LIGGGHTS RUN input (CFD-DEM, restart)
#  Restarts from in.liggghts_init. Fix: heat/gran/electric (electric6 model).
#  Mechanical/thermal parameters are identical to in.liggghts_init.
#  Atom types: 1 = steel particles | 2 = electrode plates | 3 = glass tube wall
################################################################################

#=============================== PARAMETERS ===================================#

#------- Paths / run control --------------------------------------------------#
variable dir       string ../DEM          # case folder (post/, log)
variable meshDir   string ../DEM/meshes   # STL folder of the run stage
variable topShift  equal -0.5             # z-translation of top_plate.stl (electrode onto the bed) [m]
variable firstRun  equal 1                # 1 = reset bed temperature to T0; 0 = continue from restart
variable freeze    equal 0                # 1 = particles fixed in place (no nve/sphere)
variable px        equal 1                # processor grid
variable py        equal 1
variable pz        equal 2

#------- Particles ------------------------------------------------------------#
variable rP        equal 0.00635          # particle radius                            [m]
variable rhoP      equal 7800             # particle density                           [kg/m3]

#------- Mechanical -----------------------------------------------------------#
variable YP        equal 1.9e8            # Young's modulus particles (reduced)        [Pa]
variable YW2       equal 1.9e8            # Young's modulus electrode plates (reduced) [Pa]
variable YW3       equal 1.9e8            # Young's modulus glass wall (reduced)       [Pa]
variable YoP       equal 2.1e11           # original Young's modulus particles         [Pa]
variable YoW2      equal 2.1e11           # original Young's modulus electrode plates  [Pa]
variable YoW3      equal 2.1e11           # original Young's modulus glass wall        [Pa]
variable nu        equal 0.27             # Poisson ratio (all types)                  [-]
variable ePP       equal 0.98             # restitution particle-particle              [-]
variable ePW       equal 0.98             # restitution particle-wall                  [-]
variable muPP      equal 0.1              # friction particle-particle                 [-]
variable muPW      equal 0.3              # friction particle-wall                     [-]
variable kn        equal 2e5              # normal stiffness   (only used with model hooke)
variable kt        equal 1e5              # tangential stiff.  (only used with model hooke)
variable gn        equal 600              # normal damping     (only used with model hooke)
variable gt        equal 600              # tangential damping (only used with model hooke)

#------- Thermal ----------------------------------------------------------------#
variable kP        equal 43.0             # thermal conductivity particles             [W/m/K]
variable kW2       equal 43.0             # thermal conductivity electrode plates      [W/m/K]
variable kW3       equal 0.8              # thermal conductivity glass                 [W/m/K]
variable cpP       equal 448.0            # heat capacity particles                    [J/kg/K]
variable cpW2      equal 448.0            # heat capacity electrode plates             [J/kg/K]
variable cpW3      equal 840.0            # heat capacity glass                        [J/kg/K]
variable epsP      equal 0.8              # emissivity particles                       [-]
variable epsW2     equal 0.8              # emissivity electrode plates                [-]
variable epsW3     equal 0.6              # emissivity glass                           [-]
variable radiation string "yes 298"       # 'no' or 'yes <T_background>'
variable T0        equal 296              # initial particle / convection temperature  [K]
variable Twall     equal 296              # wall temperature                           [K]
variable tempCtrl  string no              # 'no' or 'yes <T_limit>', e.g. "yes 1073"

#------- Electrical -----------------------------------------------------------#
variable ECP       equal 4.28e5           # sigma0 particles at Tref                   [S/m]
variable ECW2      equal 4.26e5           # sigma0 electrode plates at Tref            [S/m]
variable ECW3      equal 1.0e-10          # sigma0 glass                               [S/m]
variable alphaP    equal 0.0              # sigma(T) = sigma0/(1+alpha*(T-Tref)), particles [1/K]
variable alphaW2   equal 0.0              # same, electrode plates                     [1/K]
variable alphaW3   equal 0.0              # same, glass                                [1/K]
variable Tref      equal 293.15           # reference temperature for sigma0           [K]
variable sigFloor  equal 1.0e-6           # numerical floor for sigma                  [S/m]
variable aSpot     equal 6.0e-2           # a-spot fraction (old model: 0.06 here = 0.015 in the new model)
variable Gmin      equal 1e-16            # contacts with G < Gmin are dropped         [S]
variable areaCorr  string yes             # particle-particle contact radius from original Y
variable Vbot      equal 0.0              # bottom plate potential                     [V]
variable Vtop      equal 0.8              # top plate potential                        [V]
variable tJoule    equal 0.0              # Joule heating start time                   [s]
variable nbDia     equal 1.0              # neighbor_dia (1.0 = only touching spheres conduct)
variable minOvl    equal 0.0              # min_overlap  (0.0 = no overlap floor)

#------- Numerics / coupling / output -----------------------------------------#
variable skin      equal 0.01             # neighbour skin                             [m]
variable dtDEM     equal 5.0e-5           # DEM timestep                               [s]
variable dtCFD     equal 5.0e-3           # CFD timestep (controlDict deltaT)          [s]
variable g         equal 9.81             # gravity                                    [m/s2]
variable exportEv  equal 1000             # electric log interval (export_every)       [steps]
variable nThermo   equal 20
variable nEvol     equal 1000             # evolutionDEM.csv interval                  [steps]
variable nDump     equal 1000             # VTK dump interval                          [steps]

variable coupleEv  equal floor(${dtCFD}/${dtDEM}+0.5)
variable Gp        equal ${YP}/(2.0*(1.0+${nu}))
variable tRay      equal 3.14159265358979*${rP}*sqrt(${rhoP}/${Gp})/(0.1631*${nu}+0.8766)
variable dtRatio   equal ${dtDEM}/${tRay}
print "[SETUP] couple_every = ${coupleEv}  |  dt_DEM / t_Rayleigh = ${dtRatio} (keep below ~0.2)"

#================================ SETUP =======================================#

echo            both
log             ${dir}/log.liggghts
thermo_log      ${dir}/post/thermo.txt

atom_style      granular
atom_modify     map array
communicate     single vel yes

boundary        m m m
newton          off

units           si
processors      ${px} ${py} ${pz}

read_restart    ${dir}/post/restart/liggghts.restart

neighbor        ${skin} bin
neigh_modify    delay 0

#=========================== MATERIAL PROPERTIES ==============================#

fix  m1 all property/global youngsModulus peratomtype ${YP} ${YW2} ${YW3}
fix  m2 all property/global poissonsRatio peratomtype ${nu} ${nu} ${nu}
fix  m3 all property/global coefficientRestitution peratomtypepair 3 &
     ${ePP} ${ePW} ${ePW} &
     ${ePW} ${ePW} ${ePW} &
     ${ePW} ${ePW} ${ePW}
fix  m4 all property/global coefficientFriction peratomtypepair 3 &
     ${muPP} ${muPW} ${muPW} &
     ${muPW} ${muPW} ${muPW} &
     ${muPW} ${muPW} ${muPW}
fix  m5 all property/global kn peratomtypepair 3 ${kn} ${kn} ${kn} ${kn} ${kn} ${kn} ${kn} ${kn} ${kn}
fix  m6 all property/global kt peratomtypepair 3 ${kt} ${kt} ${kt} ${kt} ${kt} ${kt} ${kt} ${kt} ${kt}
fix  m7 all property/global gamman peratomtypepair 3 ${gn} ${gn} ${gn} ${gn} ${gn} ${gn} ${gn} ${gn} ${gn}
fix  m8 all property/global gammat peratomtypepair 3 ${gt} ${gt} ${gt} ${gt} ${gt} ${gt} ${gt} ${gt} ${gt}
fix  m16 all property/global youngsModulusOriginal peratomtype ${YoP} ${YoW2} ${YoW3}

fix  m9  all property/global electricalConductivity  peratomtype ${ECP}  ${ECW2}  ${ECW3}   # [S/m]
fix  m10 all property/global thermalEmissivity       peratomtype ${epsP} ${epsW2} ${epsW3}  # [-]
fix  m11 all property/global electricalAspotFraction peratomtype ${aSpot} ${aSpot} ${aSpot} # [-]

# sigma(T) = sigma0 / (1 + alpha*(T - Tref)), floored at sigFloor
fix  m12 all property/global electricalSigma0     peratomtype ${ECP} ${ECW2} ${ECW3}             # [S/m] at Tref
fix  m13 all property/global electricalAlpha      peratomtype ${alphaP} ${alphaW2} ${alphaW3}    # [1/K]
fix  m14 all property/global electricalTref       scalar ${Tref}                                 # [K]
fix  m15 all property/global electricalSigmaFloor scalar ${sigFloor}                             # [S/m]

# Per-atom fields (same names and IDs as in the init file, so the restart data is restored)
fix  eP      all property/atom eP      scalar yes yes no 0.0
fix  qj      all property/atom qj      scalar yes yes no 0.0
fix  cMatrix all property/atom cMatrix scalar yes yes no 0.0
fix  pwEP    all property/atom pwEP    scalar yes yes no 0.0
fix  pwER    all property/atom pwER    scalar yes yes no 0.0

#=============================== CONTACT MODEL ================================#

pair_style  gran model hertz tangential history
pair_coeff  * *

timestep    ${dtDEM}
fix         gravi all gravity ${g} vector 0.0 0.0 -1.0

#=================================== WALLS ====================================#

fix  cad1 all mesh/surface file ${meshDir}/wall_cyl.stl     type 3 scale 1 temperature ${Twall}
fix  cad2 all mesh/surface file ${meshDir}/bottom_plate.stl type 2 scale 1 temperature ${Twall} electricPotential ${Vbot}
fix  cad3 all mesh/surface file ${meshDir}/top_plate.stl    type 2 scale 1 temperature ${Twall} electricPotential ${Vtop} move 0. 0. ${topShift}
fix  geometry all wall/gran model hertz tangential history mesh n_meshes 3 meshes cad1 cad2 cad3

#=============================== HEAT TRANSFER ================================#

fix  ftco all property/global thermalConductivity peratomtype ${kP}  ${kW2}  ${kW3}    # [W/(m K)]
fix  ftca all property/global thermalCapacity     peratomtype ${cpP} ${cpW2} ${cpW3}   # [J/(kg K)]

#=============================== CFD COUPLING =================================#

fix  cfd  all couple/cfd couple_every ${coupleEv} mpi
fix  cfd2 all couple/cfd/force/implicit
fix  cfd3 all couple/cfd/convection T0 ${T0}

fix  electransfer all heat/gran/electric initial_temperature ${T0} initial_electricPotential 0. &
     contact_area overlap area_correction ${areaCorr} start_time ${tJoule} temp_control ${tempCtrl} &
     neighbor_dia ${nbDia} min_overlap ${minOvl} Gmin ${Gmin} export_every ${exportEv} radiation ${radiation}

# set particle temperature for the bed (only on the first run, not when continuing)
run     0
region  total block INF INF INF INF INF INF units box
if "${firstRun} == 1" then "set region total property/atom Temp ${T0}"

if "${freeze} == 0" then "fix integr all nve/sphere"

#================================ OUTPUT ======================================#

compute     rke   all erotate/sphere
compute     Tave  all reduce ave f_Temp[0]
compute     Tmax  all reduce max f_Temp[0]
compute     Pjou  all reduce sum f_qj[0]
compute     Idev  all reduce max f_tot_I[0]
compute     nAct  all reduce sum f_compID[0]

variable    t     equal step*dt
variable    dV    equal abs(${Vtop}-${Vbot})
variable    Tave  equal c_Tave
variable    Tmax  equal c_Tmax
variable    P     equal c_Pjou
variable    I     equal c_Idev
variable    R     equal v_dV/(c_Idev+1.0e-30)
variable    nAct  equal c_nAct

thermo_style    custom step atoms ke c_rke vol c_Tave c_Tmax c_Pjou c_Idev
thermo          ${nThermo}
thermo_modify   lost ignore norm no
compute_modify  thermo_temp dynamic yes

fix   evol all print ${nEvol} "${t}, ${Tave}, ${Tmax}, ${P}, ${I}, ${R}, ${nAct}" &
      file ${dir}/post/evolutionDEM.csv screen no &
      title "time[s], Tave[K], Tmax[K], P_joule[W], I[A], R_bed[Ohm], n_active[-]"

dump  dmpvtk all custom/vtk ${nDump} ${dir}/post/dump_liggghts_run.*.vtk id type x y z vx vy vz fx fy fz &
      f_dragforce[1] f_dragforce[2] f_dragforce[3] radius f_Temp[0] f_heatFlux[0] f_heatSource[0] &
      f_eP[0] f_qj[0] f_qj_pp[0] f_qj_pw[0] f_qr[0] f_cMatrix[0] f_pwEP[0] f_pwER[0] &
      f_current[1] f_current[2] f_current[3] f_compID[0] f_deltaE[0] f_tot_I[0] f_total_C[0]

reset_timestep  0
run             0
